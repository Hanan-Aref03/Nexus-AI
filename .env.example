# NexusAI backend defaults
# Copy to `.env` before running the app locally.

APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg2://nexusai:nexusai@localhost:5432/nexusai
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
AUTH_SIGNING_KEY=dev-only-change-me
AUTH_TOKEN_ISSUER=nexusai
AUTH_TOKEN_AUDIENCE=nexusai-web
VAULT_ADDRESS=
VAULT_TOKEN=
VAULT_SECRET_MOUNT=secret
VAULT_SECRET_PATH=nexusai/security
GUARDRAILS_ENABLED=false
RAGAS_ENABLED=false
OTEL_SERVICE_NAME=nexusai-api
OTEL_CONSOLE_EXPORTER=true
